---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
---

<BaseLayout
  title="About"
  description="Built by a developer, for developers. 30 years in tech, 10 years teaching. Steve Brownlee founded Stepping Stone Labs to help developers grow."
>
  <!-- Hero -->
  <HeroSection
    title="Built by a Developer, for Developers"
    subtitle="After 30 years in the software development industry and 10 years of building the learning experience at Nashville Software School, Steve Brownlee founded Stepping Stone Labs as the next evolution in learning and growth for software developers."
  />

  <!-- Bio Section -->
  <section class="bg-white py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <!-- Photo -->
        <div class="animate-on-scroll">
          <div class="overflow-hidden rounded-2xl border border-zinc-200">
            <img
              src="/images/about/steve.png"
              alt="Steve Brownlee, founder of Stepping Stone Labs"
              class="w-full aspect-[4/5] object-cover"
            />
          </div>
        </div>

        <!-- Bio text -->
        <div class="animate-on-scroll space-y-6">
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-zinc-900 mb-6">
            Launched by Steve Brownlee
          </h2>
          <p class="text-zinc-600 leading-relaxed text-lg">
            After 30 years in the software development industry, and 10 years of building the learning experience at Nashville Software School, Steve Brownlee founded <strong class="text-zinc-900">Stepping Stone Labs</strong> as the next evolution in learning and growth for software developers.
          </p>
          <p class="text-zinc-600 leading-relaxed text-lg">
            This program was born out of a desire to empower people to grow in their career as software developers. Before Stepping Stone Labs, the only structured learning environments were for beginners. University, internships, or bootcamps were your options to break into the field.
          </p>
          <p class="text-zinc-600 leading-relaxed text-lg">
            Steve is a highly skilled coach, mentor, technologist, and educator. This unique combination of skills allows him to cut through potential biases and identify the core skills and competencies that people need to succeed and grow in their software careers.
          </p>

          <!-- Credentials -->
          <div class="mt-8 space-y-3">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-indigo-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-zinc-600">Veteran of Technology and Software since 1993</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-indigo-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-zinc-600">Technology Leadership since 2001</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-indigo-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-zinc-600">Technology Mentoring since 2007</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Credentials Timeline -->
  <section class="bg-zinc-50 py-24 lg:py-32">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-zinc-900 text-center mb-16 animate-on-scroll">
        The Journey
      </h2>

      <div class="relative animate-on-scroll">
        <!-- Timeline line -->
        <div class="absolute left-8 lg:left-1/2 top-0 bottom-0 w-px bg-zinc-300 -translate-x-1/2"></div>

        <!-- Timeline items -->
        <div class="space-y-12">
          <div class="relative flex items-start gap-8 lg:gap-0">
            <div class="lg:w-1/2 lg:pr-12 lg:text-right">
              <div class="font-mono text-indigo-600 text-lg font-bold">1993</div>
              <div class="text-zinc-900 font-semibold mt-1">Technology & Software Development</div>
              <p class="text-zinc-500 text-sm mt-1">Began a career in technology and software development</p>
            </div>
            <div class="absolute left-8 lg:left-1/2 w-4 h-4 bg-indigo-500 rounded-full -translate-x-1/2 mt-1 ring-4 ring-zinc-50"></div>
            <div class="lg:w-1/2 lg:pl-12 hidden lg:block"></div>
          </div>

          <div class="relative flex items-start gap-8 lg:gap-0">
            <div class="lg:w-1/2 lg:pr-12 hidden lg:block"></div>
            <div class="absolute left-8 lg:left-1/2 w-4 h-4 bg-indigo-400 rounded-full -translate-x-1/2 mt-1 ring-4 ring-zinc-50"></div>
            <div class="lg:w-1/2 lg:pl-12 pl-8">
              <div class="font-mono text-indigo-600 text-lg font-bold">2001</div>
              <div class="text-zinc-900 font-semibold mt-1">Technology Leadership</div>
              <p class="text-zinc-500 text-sm mt-1">Transitioned into leading technology teams</p>
            </div>
          </div>

          <div class="relative flex items-start gap-8 lg:gap-0">
            <div class="lg:w-1/2 lg:pr-12 lg:text-right">
              <div class="font-mono text-indigo-600 text-lg font-bold">2007</div>
              <div class="text-zinc-900 font-semibold mt-1">Technology Mentoring</div>
              <p class="text-zinc-500 text-sm mt-1">Began mentoring the next generation of developers</p>
            </div>
            <div class="absolute left-8 lg:left-1/2 w-4 h-4 bg-indigo-400 rounded-full -translate-x-1/2 mt-1 ring-4 ring-zinc-50"></div>
            <div class="lg:w-1/2 lg:pl-12 hidden lg:block"></div>
          </div>

          <div class="relative flex items-start gap-8 lg:gap-0">
            <div class="lg:w-1/2 lg:pr-12 hidden lg:block"></div>
            <div class="absolute left-8 lg:left-1/2 w-4 h-4 bg-indigo-400 rounded-full -translate-x-1/2 mt-1 ring-4 ring-zinc-50"></div>
            <div class="lg:w-1/2 lg:pl-12 pl-8">
              <div class="font-mono text-indigo-600 text-lg font-bold">2015</div>
              <div class="text-zinc-900 font-semibold mt-1">Technology Education</div>
              <p class="text-zinc-500 text-sm mt-1">Joined Nashville Software School as lead instructor</p>
            </div>
          </div>

          <div class="relative flex items-start gap-8 lg:gap-0">
            <div class="lg:w-1/2 lg:pr-12 lg:text-right">
              <div class="font-mono text-indigo-600 text-lg font-bold">2019</div>
              <div class="text-zinc-900 font-semibold mt-1">30+ Cohorts Completed</div>
              <p class="text-zinc-500 text-sm mt-1">10 years at NSS, coaching 30+ cohorts of students</p>
            </div>
            <div class="absolute left-8 lg:left-1/2 w-4 h-4 bg-indigo-400 rounded-full -translate-x-1/2 mt-1 ring-4 ring-zinc-50"></div>
            <div class="lg:w-1/2 lg:pl-12 hidden lg:block"></div>
          </div>

          <div class="relative flex items-start gap-8 lg:gap-0">
            <div class="lg:w-1/2 lg:pr-12 hidden lg:block"></div>
            <div class="absolute left-8 lg:left-1/2 w-4 h-4 bg-indigo-500 rounded-full -translate-x-1/2 mt-1 ring-4 ring-zinc-50"></div>
            <div class="lg:w-1/2 lg:pl-12 pl-8">
              <div class="font-mono text-indigo-600 text-lg font-bold">2024</div>
              <div class="text-zinc-900 font-semibold mt-1">Stepping Stone Labs Founded</div>
              <p class="text-zinc-500 text-sm mt-1">The next evolution in learning and growth for developers</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy Section -->
  <section class="bg-white py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-zinc-900 text-center mb-16 animate-on-scroll">
        Our Philosophy
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 animate-on-scroll">
        <div class="bg-zinc-50 border border-zinc-200 rounded-2xl p-8 text-center">
          <div class="w-16 h-16 bg-indigo-100 rounded-2xl flex items-center justify-center mx-auto mb-6">
            <span class="text-3xl">🧠</span>
          </div>
          <h3 class="font-display text-xl font-bold text-zinc-900 mb-3">Competency Over Knowledge</h3>
          <p class="text-zinc-500 text-sm leading-relaxed">
            We focus on building practical competencies through hands-on experience, not just delivering information through lectures and videos.
          </p>
        </div>
        <div class="bg-zinc-50 border border-zinc-200 rounded-2xl p-8 text-center">
          <div class="w-16 h-16 bg-indigo-100 rounded-2xl flex items-center justify-center mx-auto mb-6">
            <span class="text-3xl">🤝</span>
          </div>
          <h3 class="font-display text-xl font-bold text-zinc-900 mb-3">Cohort-Based Learning</h3>
          <p class="text-zinc-500 text-sm leading-relaxed">
            Learning alongside motivated peers creates accountability, builds networks, and makes the journey more rewarding and effective.
          </p>
        </div>
        <div class="bg-zinc-50 border border-zinc-200 rounded-2xl p-8 text-center">
          <div class="w-16 h-16 bg-indigo-100 rounded-2xl flex items-center justify-center mx-auto mb-6">
            <span class="text-3xl">🎯</span>
          </div>
          <h3 class="font-display text-xl font-bold text-zinc-900 mb-3">Mentored, Not Lectured</h3>
          <p class="text-zinc-500 text-sm leading-relaxed">
            An experienced mentor available in every session provides guidance, support, and real-time feedback to accelerate your growth.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-indigo-600 py-20 lg:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
        Ready to accelerate your career?
      </h2>
      <p class="text-indigo-100 text-lg mb-10 max-w-xl mx-auto">
        Schedule a free 30-minute discovery call. No pressure, no pitch — just an honest conversation.
      </p>
      <a
        href="https://calendly.com/stevebrownlee/consultation"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-10 py-4 bg-white text-indigo-700 font-semibold rounded-xl hover:bg-indigo-50 transition-colors duration-200 text-lg"
      >
        Book Your Free Call
      </a>
    </div>
  </section>
</BaseLayout>
