---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../../components/HeroSection.astro";
import Icon from "../../components/Icon.astro";
---

<BaseLayout
  title="Packages"
  description="Programs that match your goals. From long-term career acceleration to expert 1-on-1 technical mentoring and coaching."
>
  <HeroSection
    title="Programs That Match Your Goals"
    subtitle="Whether you're looking for long-term career acceleration or expert technical mentoring and coaching — we have a path for you."
  />

  <section class="bg-white py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12">
        <!-- Ascend Card -->
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-8 bg-zinc-50 border border-zinc-200 rounded-2xl overflow-hidden hover:border-indigo-300 hover:shadow-lg transition-all duration-300"
        >
          <a href="/packages/coaching/" class="group block animate-on-scroll">
            <div class="p-8 lg:p-12 flex flex-col justify-center">
              <div class="mb-4">
                <Icon name="message-circle" class="w-10 h-10 text-teal-500" />
              </div>
              <h2
                class="font-display text-3xl font-bold text-zinc-900 mb-4 group-hover:text-teal-600 transition-colors"
              >
                Technical Mentoring & Coaching
              </h2>
              <p class="text-zinc-500 leading-relaxed mb-6">
                Expert 1-on-1 technical mentoring on any topic — plus weekly AI
                coaching sessions.
              </p>
              <p class="font-mono text-teal-600 font-medium mb-6">
                Free 30-minute consultation
              </p>
              <span
                class="inline-flex items-center gap-2 text-teal-500 group-hover:text-teal-700 font-semibold transition-colors"
              >
                Learn about Coaching & Mentoring →
              </span>
            </div>
          </a>

          <a href="/packages/ascend/" class="group block animate-on-scroll">
            <div class="p-8 lg:p-12 flex flex-col justify-center">
              <div class="mb-4">
                <Icon name="plane-takeoff" class="w-10 h-10 text-indigo-600" />
              </div>
              <h2
                class="font-display text-3xl font-bold text-zinc-900 mb-4 group-hover:text-indigo-600 transition-colors"
              >
                Ascend Program
              </h2>
              <p class="text-zinc-500 leading-relaxed mb-6">
                Long-term, large-scale project work to accelerate your career.
                Transform from capable developer to respected senior engineer
                through cohort-based, mentored learning.
              </p>
              <p class="font-mono text-indigo-600 font-medium mb-6">
                $3,000 per tier • 6-8 months
              </p>
              <span
                class="inline-flex items-center gap-2 text-indigo-500 group-hover:text-indigo-700 font-semibold transition-colors"
              >
                Learn more about Ascend →
              </span>
            </div>
          </a>
        </div>

        <!-- Coaching & Mentoring Card -->
      </div>
    </div>
  </section>
</BaseLayout>
