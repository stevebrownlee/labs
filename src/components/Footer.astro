---
const currentYear = new Date().getFullYear();
---

<footer class="bg-zinc-50 border-t border-zinc-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 lg:gap-16">
      <!-- Column 1: Logo + Tagline + Social -->
      <div>
        <a href="/" class="inline-block mb-4">
          <span class="font-display text-3xl font-bold text-zinc-900">
            SSL<span class="text-amber-500">.</span>
          </span>
        </a>
        <p class="text-zinc-500 text-sm leading-relaxed mb-6 max-w-sm">
          Evolve faster than the tools you depend on. Hands-on coaching and workshops for software developers.
        </p>
        <div class="flex items-center gap-4">
          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/company/steppingstonelabs"
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-400 hover:text-indigo-600 transition-colors duration-200"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <!-- GitHub -->
          <a
            href="https://github.com/steppingstonelabs"
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-400 hover:text-indigo-600 transition-colors duration-200"
            aria-label="GitHub"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <!-- Twitter -->
          <a
            href="https://twitter.com/steppingstonelabs"
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-400 hover:text-indigo-600 transition-colors duration-200"
            aria-label="Twitter"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h3 class="text-zinc-900 font-semibold text-sm uppercase tracking-wider mb-6">Quick Links</h3>
        <ul class="space-y-3">
          <li><a href="/" class="text-zinc-500 hover:text-indigo-600 text-sm transition-colors duration-200">Home</a></li>
          <li><a href="/packages/" class="text-zinc-500 hover:text-indigo-600 text-sm transition-colors duration-200">Packages</a></li>
          <li><a href="/packages/ascend/" class="text-zinc-500 hover:text-indigo-600 text-sm transition-colors duration-200">Ascend Program</a></li>
          <li><a href="/packages/coaching/" class="text-zinc-500 hover:text-indigo-600 text-sm transition-colors duration-200">Coaching & Mentoring</a></li>
          <li><a href="/about/" class="text-zinc-500 hover:text-indigo-600 text-sm transition-colors duration-200">About</a></li>
        </ul>
      </div>

      <!-- Column 3: Contact -->
      <div>
        <h3 class="text-zinc-900 font-semibold text-sm uppercase tracking-wider mb-6">Get in Touch</h3>
        <ul class="space-y-4">
          <li>
            <a href="mailto:coach@steppingstonelabs.com" class="flex items-center gap-3 text-zinc-500 hover:text-indigo-600 text-sm transition-colors duration-200">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              coach@steppingstonelabs.com
            </a>
          </li>
          <li>
            <a href="tel:+16152410666" class="flex items-center gap-3 text-zinc-500 hover:text-indigo-600 text-sm transition-colors duration-200">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +1 (615) 241-0666
            </a>
          </li>
          <li class="pt-2">
            <a
              href="https://calendly.com/stevebrownlee/consultation"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition-colors duration-200"
            >
              Book a Free Call
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-16 pt-8 border-t border-zinc-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-400">
      <p>&copy; {currentYear} Stepping Stone Labs. All rights reserved.</p>
      <p class="flex items-center gap-1">
        Built with
        <svg class="w-4 h-4 text-indigo-500" viewBox="0 0 85 107" fill="currentColor">
          <path d="M27.5893 91.1365C22.7555 86.7178 21.3443 77.4335 23.3583 70.7072C26.8503 74.948 31.6888 76.2914 36.7005 77.0497C44.4374 78.2199 52.0358 77.7842 59.2231 74.2543C60.0453 73.8511 60.7975 73.3053 61.6764 72.7836C62.3027 74.8682 62.4376 76.9756 62.1532 79.1001C61.4989 84.0744 59.0496 87.8691 55.2534 90.7428C53.7179 91.8991 52.0924 92.9386 50.5163 94.0402C45.8507 97.2065 44.4225 101.387 45.7849 106.853C45.8197 106.994 45.8431 107.138 45.9013 107.42C43.9022 106.208 42.4328 104.751 41.3889 102.96C40.2895 101.076 39.7441 99.0427 39.7498 96.8702C39.7612 92.8572 39.7042 88.842 38.5765 84.9495C37.8474 82.4602 36.5503 80.3926 34.0644 79.1815C33.4419 79.8498 32.8194 80.3871 32.3282 81.0197C30.4859 83.3686 29.7145 86.0855 29.5951 89.0114C29.5475 90.2057 29.5319 91.4023 29.4978 92.5978C25.4727 90.5765 27.0835 91.5765 27.5893 91.1365Z"/>
          <path d="M0 69.5866C0 69.5866 14.3139 62.6137 28.6678 62.6137L39.5765 30.543C39.9427 29.2183 40.8753 28.3101 41.9403 28.3101C43.0054 28.3101 43.938 29.2183 44.3042 30.543L55.2128 62.6137C72.1958 62.6137 83.8806 69.5866 83.8806 69.5866C83.8806 69.5866 59.5339 0.538637 59.4513 0.316502C59.0068 -0.774291 58.1703 -1.32289e-06 57.1803 -1.32289e-06H26.7004C25.7104 -1.32289e-06 24.9539 -0.774291 24.4294 0.316502C24.3468 0.538637 0 69.5866 0 69.5866Z"/>
        </svg>
        Astro
      </p>
    </div>
  </div>
</footer>
