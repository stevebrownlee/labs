---
import Icon from "./Icon.astro";

interface Props {
  variant?: "compact" | "full";
}

const { variant = "full" } = Astro.props;
---

{variant === "compact" && (
  <div class="animate-on-scroll bg-white border-2 border-teal-200 rounded-2xl p-6 lg:p-8 shadow-sm hover:shadow-md transition-shadow duration-300">
    <div class="flex flex-col lg:flex-row lg:items-center gap-6">
      <!-- Icon + Label -->
      <div class="flex items-center gap-3 lg:flex-shrink-0">
        <div class="w-12 h-12 bg-teal-50 rounded-xl flex items-center justify-center">
          <Icon name="bot" class="w-6 h-6 text-teal-500" />
        </div>
        <p class="font-mono text-teal-600 text-xs uppercase tracking-widest font-medium">
          Featured Offering
        </p>
      </div>

      <!-- Content -->
      <div class="flex-1 lg:border-l lg:border-teal-100 lg:pl-6">
        <h3 class="font-display text-xl lg:text-2xl font-bold text-zinc-900 mb-1">
          AI Coaching — Weekly Group Sessions
        </h3>
        <p class="text-teal-700 font-semibold text-sm mb-3">
          Stop Experimenting With AI. Start Mastering It.
        </p>
        <ul class="flex flex-wrap gap-x-6 gap-y-1.5 text-sm text-zinc-500">
          <li class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-teal-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Real AI fluency, not surface knowledge
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-teal-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Prompting strategies tailored to your work
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-teal-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            AI-native workflows that compound
          </li>
        </ul>
      </div>

      <!-- CTA -->
      <div class="lg:flex-shrink-0">
        <a
          href="/packages/coaching/#ai-coaching"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-teal-600 text-white font-semibold rounded-xl hover:bg-teal-700 transition-colors duration-200 text-sm whitespace-nowrap"
        >
          Learn More
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
)}

{variant === "full" && (
  <div
    id="ai-coaching"
    class="bg-white border-2 border-teal-200 rounded-3xl p-8 lg:p-12 shadow-sm animate-on-scroll"
  >
    <div class="flex items-center gap-3 mb-6">
      <div
        class="w-12 h-12 bg-teal-50 rounded-xl flex items-center justify-center"
      >
        <Icon name="bot" class="w-6 h-6 text-teal-500" />
      </div>
      <p class="font-mono text-teal-600 text-sm uppercase tracking-widest">
        Featured Offering
      </p>
    </div>

    <h2 class="font-display text-3xl sm:text-4xl font-bold text-zinc-900 mb-4">
      AI Coaching — Weekly Group Sessions
    </h2>
    <p class="text-xl text-teal-700 font-semibold mb-8">
      Stop Experimenting With AI. Start Mastering It.
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="space-y-6">
        <div>
          <h3 class="text-zinc-900 font-semibold mb-2">What</h3>
          <p class="text-zinc-500 leading-relaxed">
            A recurring weekly session focused on building genuine AI
            fluency — tools like ChatGPT and Claude, prompting systems,
            AI-native development, and workflow automation. This is a
            systematic approach to making AI a real part of how you work.
          </p>
        </div>
        <div>
          <h3 class="text-zinc-900 font-semibold mb-2">Format</h3>
          <p class="text-zinc-500 leading-relaxed">
            Weekly group format — learn alongside other developers and
            founders. Get the benefit of shared perspectives while building
            real skills you can apply immediately.
          </p>
        </div>
      </div>
      <div class="space-y-6">
        <div>
          <h3 class="text-zinc-900 font-semibold mb-2">Who It's For</h3>
          <p class="text-zinc-500 leading-relaxed">
            Developers and founders ready to go beyond dabbling. If you've
            played with AI tools but haven't built a system around them — if
            you know there's a gap between where you are and where you could
            be — this is where you close it.
          </p>
        </div>
        <div>
          <h3 class="text-zinc-900 font-semibold mb-2">What You'll Build</h3>
          <ul class="space-y-2 text-zinc-500">
            <li class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-teal-500 flex-shrink-0 mt-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5 13l4 4L19 7"></path></svg
              >
              Real fluency with AI tools — not just surface knowledge
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-teal-500 flex-shrink-0 mt-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5 13l4 4L19 7"></path></svg
              >
              Prompting strategies tailored to your work
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-teal-500 flex-shrink-0 mt-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5 13l4 4L19 7"></path></svg
              >
              AI-native development workflows that compound
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
)}
