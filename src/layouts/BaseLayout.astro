---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const siteTitle = `${title} | Stepping Stone Labs`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/images/favicon/favicon.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{siteTitle}</title>
  </head>
  <body class="bg-white text-zinc-900 font-sans antialiased overflow-x-hidden">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Scroll animation observer -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('animate-in');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
      );

      document.querySelectorAll('.animate-on-scroll').forEach((el) => {
        observer.observe(el);
      });
    </script>

    <style is:global>
      /* Animation classes */
      .animate-on-scroll {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.7s ease-out, transform 0.7s ease-out;
      }

      .animate-on-scroll.animate-in {
        opacity: 1;
        transform: translateY(0);
      }

      /* Marquee animation */
      @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }

      .animate-marquee {
        animation: marquee 30s linear infinite;
      }

      /* Prose styles for MDX content */
      .prose {
        max-width: 70ch;
        line-height: 1.8;
      }

      .prose h1 {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        margin-top: 2.5rem;
        line-height: 1.2;
        color: rgb(24 24 27);
      }

      .prose h2 {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 1.75rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
        margin-top: 2rem;
        line-height: 1.3;
        color: rgb(24 24 27);
      }

      .prose h3 {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 1.35rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        margin-top: 1.5rem;
        line-height: 1.4;
        color: rgb(24 24 27);
      }

      .prose p {
        margin-bottom: 1.25rem;
        color: rgb(63 63 70);
      }

      .prose ul, .prose ol {
        margin-bottom: 1.25rem;
        padding-left: 1.5rem;
      }

      .prose ul { list-style-type: disc; }
      .prose ol { list-style-type: decimal; }

      .prose li {
        margin-bottom: 0.5rem;
        color: rgb(63 63 70);
      }

      .prose strong {
        color: rgb(24 24 27);
        font-weight: 600;
      }

      .prose a {
        color: #4f3fd4;
        text-decoration: underline;
        text-underline-offset: 3px;
        transition: color 0.2s ease;
      }

      .prose a:hover {
        color: #3d2db5;
      }

      .prose blockquote {
        border-left: 3px solid #fbbf24;
        padding-left: 1rem;
        margin: 1.5rem 0;
        font-style: italic;
        color: rgb(82 82 91);
      }

      .prose code {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.9em;
        background: rgb(228 228 231);
        color: rgb(24 24 27);
        padding: 0.15rem 0.4rem;
        border-radius: 0.25rem;
      }
    </style>
  </body>
</html>
